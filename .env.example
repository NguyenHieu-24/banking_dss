# ===== Cải tiến 4: dùng Environment Variables, KHÔNG hardcode trong source =====
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env` lên git.

# Để TRỐNG MONGO_URI nếu chưa dựng MongoDB -> hệ thống tự fallback sang JSON cục bộ.
MONGO_URI=
MONGO_DB=credit_dss

# Khoá bí mật của ứng dụng (đổi sang chuỗi ngẫu nhiên dài khi triển khai thật)
APP_SECRET=change-me-to-a-long-random-string

# Số vòng lặp băm mật khẩu PBKDF2 (cao hơn = an toàn hơn nhưng chậm hơn)
PBKDF2_ITERATIONS=200000

# Mật khẩu seed mặc định (chỉ dùng khi chạy seed_users.py)
SEED_STAFF_PW=Staff@123
SEED_CUSTOMER_PW=Customer@123
